<controls:ProWindow x:Class="SSI_ArcGIS_Addin.ExportGpxWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
                    xmlns:local="clr-namespace:SSI_ArcGIS_Addin"
                    Title="Export GPX"
                    Width="560" Height="220" MinWidth="460" MinHeight="200"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="CanResize" ShowInTaskbar="False">
  <Grid>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Springs layer -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Springs layer:" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"
                  ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"
                  DisplayMemberPath="DisplayName" />

        <!-- GPX file path + Browse -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="GPX file:" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                 Text="{Binding GpxPath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." MinWidth="80" Padding="10,3"
                Command="{Binding BrowseCommand}" />

        <!-- OK / Cancel + validation -->
        <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" LastChildFill="False"
                   Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#B00020"
                       TextWrapping="Wrap" MaxWidth="320" Text="{Binding ValidationMessage}" />
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="80" Padding="10,3" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancelClick" />
            <Button DockPanel.Dock="Right" Content="OK" MinWidth="80" Padding="10,3"
                    IsDefault="True" IsEnabled="{Binding CanAccept}" Click="OnOkClick" />
        </DockPanel>
    </Grid>

    <!-- Resize grip, always anchored to the window's bottom-right corner. -->
    <Image x:Name="ResizeGrip" Stretch="None" Width="15" Height="15"
           Source="pack://application:,,,/SSI_ArcGIS_Addin;component/Images/resize_grip.png"
           HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Margin="0,0,3,3" IsHitTestVisible="False"
           ToolTip="Drag an edge or corner to resize this window." />
  </Grid>
</controls:ProWindow>
