<?xml version="1.0" encoding="utf-8" ?>
<ArcGIS defaultAssembly="SSI_ArcGIS_Addin.dll"
        defaultNamespace="SSI_ArcGIS_Addin"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">

  <AddInInfo id="{738e31ff-cf24-451e-88f9-2e82c4fc833f}" version="1.6.4" desktopVersion="3.7.1901" product="ArcGISPro">
    <Name>SSI_ArcGIS_Addin</Name>   
    <Description>Tools to aid in Springs Stewardship GIS projects.</Description>
    <Image>Images\AddInIcon_32.png</Image>
    <Author>Jeff Jenness</Author>
    <Company>Springs Stewardship Institute</Company>
    <Date>6/11/2026 9:23:34 AM</Date>
    <Subject>Framework</Subject>
    <!-- Note subject can be one or more of these topics:
                    Content, Framework, Editing, Geodatabase, Geometry, Geoprocessing, Layouts, Map Authoring, Map Exploration -->
  </AddInInfo>

  <modules>
    <insertModule id="SSI_ArcGIS_Addin_Module" className="Module1" autoLoad="false" caption="Module1">
      <tabs>
        <tab id="SSI_ArcGIS_Addin_Tab1" caption="SSI">
          <group refID="SSI_ArcGIS_Addin_Group1"/>
          <group refID="SSI_ArcGIS_Addin_Group2"/>
          <group refID="SSI_ArcGIS_Addin_GroupToys"/>
        </tab>
      </tabs>

      <groups>
        <group id="SSI_ArcGIS_Addin_Group1" caption="SSI Data">
          <!-- host controls within groups -->
          <button refID="SSI_ArcGIS_Addin_LoadSpringsFeatureClass" size="large" />
          <button refID="SSI_ArcGIS_Addin_InventoryLevel" size="large" />
        </group>
        <group id="SSI_ArcGIS_Addin_Group2" caption="SSI Tools">
          <button refID="SSI_ArcGIS_Addin_ExportGpx" size="large" />
          <button refID="SSI_ArcGIS_Addin_ExportSubsetOfSprings" size="large" />
          <button refID="SSI_ArcGIS_Addin_NearestSpringDistances" size="large" />
        </group>
        <group id="SSI_ArcGIS_Addin_GroupToys" caption="Take a Break">
          <button refID="SSI_ArcGIS_Addin_ThoughtForTheDay" size="large" />
        </group>
      </groups>
      
      <controls>
        <!-- add your controls here -->
        <button id="SSI_ArcGIS_Addin_LoadSpringsFeatureClass"
                caption="Load Springs"
                className="LoadSpringsFeatureClassButton"
                loadOnClick="true"
                smallImage="Images\Springs_Single_16.png"
                largeImage="Images\Springs_Single_32.png"
                keytip="LS">
          <tooltip heading="Load Springs Feature Class">
            Loads the Springs feature class (World_Springs) into the active map. Enabled only when a map view is active.<disabledText />
          </tooltip>
        </button>
        <button id="SSI_ArcGIS_Addin_InventoryLevel"
                caption="Inventory Level"
                className="InventoryLevelButton"
                loadOnClick="true"
                smallImage="Images\Inventory_Level_16.png"
                largeImage="Images\Inventory_Level_32.png"
                keytip="IL">
          <tooltip heading="Inventory Level">
            Loads the Springs feature class into the active map, symbolized by inventory level. Enabled only when a map view is active.<disabledText />
          </tooltip>
        </button>
        <button id="SSI_ArcGIS_Addin_ExportGpx"
                caption="Export GPX"
                className="ExportGpxButton"
                loadOnClick="true"
                smallImage="Images\Spring_GPX_16.png"
                largeImage="Images\raised_Spring_GPX_for_VB.png"
                keytip="EG">
          <tooltip heading="Export GPX">
            Exports the selected springs of a springs layer to a GPX file, formatted the same way as the Export Geodatabase tool's GPX output. Enabled only when a map view is active.<disabledText />
          </tooltip>
        </button>
        <button id="SSI_ArcGIS_Addin_ExportSubsetOfSprings"
                caption="Export Geodatabase"
                className="ExportSubsetOfSpringsButton"
                loadOnClick="true"
                smallImage="Images\Export_GDB_16.png"
                largeImage="Images\Export_GDB_32.png"
                keytip="ES">
          <tooltip heading="Export Geodatabase">
            Exports the selected springs and all related tables into a new file geodatabase, rebuilding the relationship classes. Enabled only when a map view is active.<disabledText />
          </tooltip>
        </button>
        <button id="SSI_ArcGIS_Addin_NearestSpringDistances"
                caption="Nearest Spring Distances"
                className="NearestSpringDistancesButton"
                loadOnClick="true"
                smallImage="Images\Springs_Distance_16.png"
                largeImage="Images\Springs_Distance_32.png"
                keytip="ND">
          <tooltip heading="Nearest Spring Distances">
            Calculates the distance from each spring to the nearest known spring (one whose Inventory Level is not "No Spring") and writes the results to a CSV file. Enabled only when a map view is active.<disabledText />
          </tooltip>
        </button>
        <button id="SSI_ArcGIS_Addin_ThoughtForTheDay"
                caption="Thought for the Day"
                className="ThoughtForTheDayButton"
                loadOnClick="true"
                smallImage="Images\Heart_16.png"
                largeImage="Images\Heart_32.png"
                keytip="TD">
          <tooltip heading="Thought for the Day">
            Shows a random inspirational quote in a little pop-up card.<disabledText />
          </tooltip>
        </button>
      </controls>
      
    </insertModule>
  </modules>
</ArcGIS>